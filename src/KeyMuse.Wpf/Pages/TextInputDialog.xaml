<Window x:Class="KeyMuse.Wpf.Pages.TextInputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="KeyMuse" SizeToContent="Height" Width="380"
        WindowStartupLocation="CenterScreen" ShowInTaskbar="False"
        ResizeMode="NoResize"
        Background="Transparent"
        AllowsTransparency="True"
        WindowStyle="None"
        Foreground="{StaticResource TextBrush}">
    <Border Background="{StaticResource BgBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="20" Effect="{StaticResource ShadowDepth2}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" x:Name="PromptText" Margin="0 0 0 16" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}"/>
            <TextBox Grid.Row="1" x:Name="InputBox" Margin="0 0 0 16" Padding="10 8" FontSize="13"/>
            <WrapPanel Grid.Row="2" HorizontalAlignment="Right">
                <Button Content="取消" Margin="0 0 8 0" Padding="16 8" MinWidth="80" IsCancel="True"/>
                <Button Content="确定" Margin="0" Padding="16 8" MinWidth="80" IsDefault="True" Click="OkBtn_Click" Background="{StaticResource AccentBrush}"/>
            </WrapPanel>
        </Grid>
    </Border>
</Window>