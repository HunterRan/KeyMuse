<UserControl x:Class="KeyMuse.Wpf.Pages.RecordingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Left: Category List -->
        <Border Grid.Column="0" BorderBrush="#ccc" BorderThickness="0 0 1 0" Padding="8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="分类" FontWeight="Bold" Margin="0 0 0 8"/>
                <ListBox Grid.Row="1" x:Name="CategoryList" SelectionChanged="CategoryList_SelectionChanged"/>
                <WrapPanel Grid.Row="2" Margin="0 8 0 0">
                    <Button Content="+ 新建分类" Margin="0 0 4 0" Padding="8 2" Click="NewCategory_Click"/>
                    <Button Content="− 删除" Padding="8 2" Click="DeleteCategory_Click"/>
                </WrapPanel>
            </Grid>
        </Border>

        <!-- Right: Recordings List + Controls -->
        <Grid Grid.Column="1" Margin="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Toolbar -->
            <WrapPanel Grid.Row="0">
                <Button x:Name="RecordBtn" Content="● 录制" Margin="0 0 4 4" Padding="12 4" Width="80" Click="RecordBtn_Click"/>
                <Button x:Name="ReplayBtn" Content="▶ 回放" Margin="0 0 4 4" Padding="12 4" Width="80" Click="ReplayBtn_Click"/>
                <Button x:Name="StopBtn" Content="■ 停止" Margin="0 0 4 4" Padding="12 4" Width="80" Click="StopBtn_Click"/>
                <Button Content="📂 导入" Margin="0 0 4 4" Padding="12 4" Click="ImportBtn_Click"/>
            </WrapPanel>

            <!-- Recording List -->
            <ListView Grid.Row="1" x:Name="RecordingList" Margin="0 4" SelectionChanged="RecordingList_SelectionChanged">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="名称" Width="140" DisplayMemberBinding="{Binding FileName}"/>
                        <GridViewColumn Header="时长" Width="70" DisplayMemberBinding="{Binding DisplayDuration}"/>
                        <GridViewColumn Header="事件" Width="60" DisplayMemberBinding="{Binding EventCount}"/>
                        <GridViewColumn Header="日期" Width="100" DisplayMemberBinding="{Binding CreatedAt}"/>
                    </GridView>
                </ListView.View>
            </ListView>

            <!-- Loop Controls -->
            <WrapPanel Grid.Row="2" Margin="0 4">
                <Label Content="循环：" VerticalAlignment="Center"/>
                <ComboBox x:Name="LoopModeCombo" Margin="4" SelectedIndex="0" Width="70">
                    <ComboBoxItem Content="单次"/>
                    <ComboBoxItem Content="N 次"/>
                    <ComboBoxItem Content="无限"/>
                </ComboBox>
                <TextBox x:Name="LoopCountBox" Margin="4" Width="60" Text="3" IsEnabled="False"/>
                <Label Content="次" VerticalAlignment="Center"/>
                <Label Content="间隔：" VerticalAlignment="Center"/>
                <TextBox x:Name="LoopIntervalBox" Margin="4" Width="60" Text="1000"/>
                <Label Content="ms" VerticalAlignment="Center"/>
            </WrapPanel>

            <!-- Action Buttons -->
            <WrapPanel Grid.Row="3" Margin="0 4">
                <Button Content="✏ 重命名" Margin="0 0 4 0" Padding="8 2" Click="RenameBtn_Click"/>
                <Button Content="🗑 删除" Margin="0 0 4 0" Padding="8 2" Click="DeleteBtn_Click"/>
                <Button Content="📤 导出" Margin="0 0 4 0" Padding="8 2" Click="ExportBtn_Click"/>
            </WrapPanel>
        </Grid>
    </Grid>
</UserControl>
