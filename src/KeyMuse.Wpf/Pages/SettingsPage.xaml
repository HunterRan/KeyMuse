<UserControl x:Class="KeyMuse.Wpf.Pages.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer>
        <Grid Margin="12" MaxWidth="500">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="配置管理" FontWeight="Bold" FontSize="16" Margin="0 0 0 12"/>

            <!-- Profile selector -->
            <Border Grid.Row="1" BorderBrush="#eee" BorderThickness="0 0 0 1" Padding="0 0 0 12" Margin="0 0 0 12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Label Grid.Column="0" Content="当前配置：" VerticalAlignment="Center"/>
                    <ComboBox Grid.Column="1" x:Name="ProfileCombo" Margin="4" SelectionChanged="ProfileCombo_SelectionChanged"/>
                    <Button Grid.Column="2" Content="+ 新建" Margin="4" Padding="8 2" Click="NewProfile_Click"/>
                </Grid>
            </Border>

            <!-- AutoClick Settings -->
            <GroupBox Grid.Row="2" Header="自动连点" Margin="0 4" Padding="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="0 4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Label Content="按键：" VerticalAlignment="Center"/>
                        <ComboBox Grid.Column="1" x:Name="ClickKeyCombo" Margin="4" SelectedIndex="0">
                            <ComboBoxItem Content="Insert" Tag="0x2D"/>
                            <ComboBoxItem Content="ScrollLock" Tag="0x91"/>
                            <ComboBoxItem Content="F13" Tag="0x7C"/>
                            <ComboBoxItem Content="F14" Tag="0x7D"/>
                            <ComboBoxItem Content="F15" Tag="0x7E"/>
                        </ComboBox>
                    </Grid>
                    <Grid Grid.Row="1" Margin="0 4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Label Content="间隔：" VerticalAlignment="Center"/>
                        <TextBox Grid.Column="1" x:Name="ClickIntervalBox" Margin="4" Text="1000"/>
                        <Label Grid.Column="2" Content="ms" VerticalAlignment="Center"/>
                    </Grid>
                    <Grid Grid.Row="2" Margin="0 4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Label Content="模式：" VerticalAlignment="Center"/>
                        <ComboBox Grid.Column="1" x:Name="ClickModeCombo" Margin="4" SelectedIndex="1">
                            <ComboBoxItem Content="按住触发"/>
                            <ComboBoxItem Content="开关切换"/>
                        </ComboBox>
                    </Grid>
                </Grid>
            </GroupBox>

            <!-- Hotkeys -->
            <GroupBox Grid.Row="3" Header="快捷键" Margin="0 4" Padding="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="0 2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="120"/>
                        </Grid.ColumnDefinitions>
                        <Label Content="录制开关" VerticalAlignment="Center"/>
                        <Label Grid.Column="1" Content="F6" FontWeight="Bold"/>
                    </Grid>
                    <Grid Grid.Row="1" Margin="0 2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="120"/>
                        </Grid.ColumnDefinitions>
                        <Label Content="回放" VerticalAlignment="Center"/>
                        <Label Grid.Column="1" Content="F7" FontWeight="Bold"/>
                    </Grid>
                    <Grid Grid.Row="2" Margin="0 2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="120"/>
                        </Grid.ColumnDefinitions>
                        <Label Content="连点开关" VerticalAlignment="Center"/>
                        <Label Grid.Column="1" Content="F8" FontWeight="Bold"/>
                    </Grid>
                    <Grid Grid.Row="3" Margin="0 2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="120"/>
                        </Grid.ColumnDefinitions>
                        <Label Content="急停" VerticalAlignment="Center"/>
                        <Label Grid.Column="1" Content="F9" FontWeight="Bold"/>
                    </Grid>
                    <Grid Grid.Row="4" Margin="0 2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="120"/>
                        </Grid.ColumnDefinitions>
                        <Label Content="显示/隐藏" VerticalAlignment="Center"/>
                        <Label Grid.Column="1" Content="F10" FontWeight="Bold"/>
                    </Grid>
                </Grid>
            </GroupBox>

            <!-- Storage Info -->
            <GroupBox Grid.Row="4" Header="存储" Margin="0 4" Padding="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="0 4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Label Content="录制目录" VerticalAlignment="Top"/>
                        <TextBlock Grid.Column="1" x:Name="RecordingDirText" TextWrapping="Wrap" Margin="4 6"/>
                    </Grid>
                    <Grid Grid.Row="1" Margin="0 4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Label Content="工作流目录" VerticalAlignment="Top"/>
                        <TextBlock Grid.Column="1" x:Name="WorkflowDirText" TextWrapping="Wrap" Margin="4 6"/>
                    </Grid>
                    <Grid Grid.Row="2" Margin="0 4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Label Content="配置目录" VerticalAlignment="Top"/>
                        <TextBlock Grid.Column="1" x:Name="ConfigDirText" TextWrapping="Wrap" Margin="4 6"/>
                    </Grid>
                </Grid>
            </GroupBox>

            <!-- Actions -->
            <WrapPanel Grid.Row="5" Margin="0 12">
                <Button Content="💾 保存设置" Margin="0 0 8 0" Padding="12 4" Click="SaveBtn_Click"/>
                <Button Content="🔄 恢复默认" Padding="12 4" Click="ResetBtn_Click"/>
            </WrapPanel>

            <!-- About -->
            <Border Grid.Row="6" BorderBrush="#eee" BorderThickness="0 1 0 0" Padding="0 12 0 0" Margin="0 12 0 0">
                <TextBlock Text="KeyMuse v1.0 — 键鼠自动化工具" Foreground="Gray" FontSize="11"/>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
