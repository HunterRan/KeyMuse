<UserControl x:Class="KeyMuse.Wpf.Pages.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BgBrush}">
    <ScrollViewer>
        <Grid Margin="16" MaxWidth="500">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="配置管理" FontWeight="SemiBold" FontSize="14" Foreground="{StaticResource TextBrush}" Margin="0 0 0 16"/>

            <Border Grid.Row="1" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0 0 0 1" Padding="12" Margin="0 0 0 16" CornerRadius="4">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Label Content="当前配置：" VerticalAlignment="Center"/>
                    <ComboBox Grid.Column="1" x:Name="ProfileCombo" Margin="4" SelectionChanged="ProfileCombo_SelectionChanged"/>
                    <Button Grid.Column="2" Content="+ 新建" Margin="4" Padding="8 2" Click="NewProfile_Click"/>
                </Grid>
            </Border>

            <GroupBox Grid.Row="2" Header="自动连点" Margin="0 4" Padding="12" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="0 4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Label Content="按键(VK)：" VerticalAlignment="Center"/>
                        <TextBox Grid.Column="1" x:Name="ClickKeyBox" Margin="4" Text="0x2D" VerticalAlignment="Center"/>
                    </Grid>
                    <Grid Grid.Row="1" Margin="0 4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Label Content="间隔：" VerticalAlignment="Center"/>
                        <TextBox Grid.Column="1" x:Name="ClickIntervalBox" Margin="4" Text="1000"/>
                        <Label Grid.Column="2" Content="ms" VerticalAlignment="Center"/>
                    </Grid>
                </Grid>
            </GroupBox>

            <GroupBox Grid.Row="3" Header="快捷键" Margin="0 4" Padding="12" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="0 2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="120"/>
                        </Grid.ColumnDefinitions>
                        <Label Content="录制开关" VerticalAlignment="Center"/>
                        <Label Grid.Column="1" Content="F6" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}"/>
                    </Grid>
                    <Grid Grid.Row="1" Margin="0 2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="120"/>
                        </Grid.ColumnDefinitions>
                        <Label Content="回放" VerticalAlignment="Center"/>
                        <Label Grid.Column="1" Content="F7" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}"/>
                    </Grid>
                    <Grid Grid.Row="2" Margin="0 2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="120"/>
                        </Grid.ColumnDefinitions>
                        <Label Content="连点开关" VerticalAlignment="Center"/>
                        <Label Grid.Column="1" Content="F8" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}"/>
                    </Grid>
                    <Grid Grid.Row="3" Margin="0 2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="120"/>
                        </Grid.ColumnDefinitions>
                        <Label Content="急停" VerticalAlignment="Center"/>
                        <Label Grid.Column="1" Content="F9" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}"/>
                    </Grid>
                    <Grid Grid.Row="4" Margin="0 2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="120"/>
                        </Grid.ColumnDefinitions>
                        <Label Content="显示/隐藏" VerticalAlignment="Center"/>
                        <Label Grid.Column="1" Content="F10" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}"/>
                    </Grid>
                </Grid>
            </GroupBox>

            <GroupBox Grid.Row="4" Header="存储" Margin="0 4" Padding="12" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="0 4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Label Content="根目录" VerticalAlignment="Center"/>
                        <TextBox Grid.Column="1" x:Name="StorageRootBox" Margin="4" Text="" VerticalAlignment="Center"/>
                        <Button Grid.Column="2" Content="浏览" Margin="4" Padding="8 2" Click="BrowseStorageRoot_Click"/>
                    </Grid>
                    <Grid Grid.Row="1" Margin="0 4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Label Content="录制目录" VerticalAlignment="Top"/>
                        <TextBlock Grid.Column="1" x:Name="RecordingDirText" TextWrapping="Wrap" Margin="4 6" Foreground="{StaticResource TextMutedBrush}"/>
                    </Grid>
                    <Grid Grid.Row="2" Margin="0 4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Label Content="工作流目录" VerticalAlignment="Top"/>
                        <TextBlock Grid.Column="1" x:Name="WorkflowDirText" TextWrapping="Wrap" Margin="4 6" Foreground="{StaticResource TextMutedBrush}"/>
                    </Grid>
                    <Grid Grid.Row="3" Margin="0 4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Label Content="配置目录" VerticalAlignment="Top"/>
                        <TextBlock Grid.Column="1" x:Name="ConfigDirText" TextWrapping="Wrap" Margin="4 6" Foreground="{StaticResource TextMutedBrush}"/>
                    </Grid>
                </Grid>
            </GroupBox>

            <GroupBox Grid.Row="5" Header="主题" Margin="0 4" Padding="12" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Label Content="界面主题" VerticalAlignment="Center"/>
                    <ComboBox Grid.Column="1" x:Name="ThemeCombo" Margin="4" SelectedIndex="0" SelectionChanged="ThemeCombo_SelectionChanged">
                        <ComboBoxItem Content="深色"/>
                        <ComboBoxItem Content="浅色"/>
                        <ComboBoxItem Content="灰色"/>
                    </ComboBox>
                </Grid>
            </GroupBox>

            <WrapPanel Grid.Row="6" Margin="0 16">
                <Button Content="💾 保存设置" Margin="0 0 8 0" Padding="12 4" Click="SaveBtn_Click" Background="{StaticResource AccentBrush}"/>
                <Button Content="🔄 恢复默认" Padding="12 4" Click="ResetBtn_Click"/>
            </WrapPanel>

            <Border Grid.Row="7" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0 1 0 0" Padding="0 12 0 0" Margin="0 8 0 0">
                <TextBlock Text="KeyMuse v1.0 — 键鼠自动化工具" Foreground="{StaticResource TextMutedBrush}" FontSize="11"/>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
