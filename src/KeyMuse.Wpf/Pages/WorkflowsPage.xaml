<UserControl x:Class="KeyMuse.Wpf.Pages.WorkflowsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BgBrush}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0 0 1 0" Padding="8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="工作流" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0 0 0 8" FontSize="12"/>
                <ListBox Grid.Row="1" x:Name="WorkflowList" DisplayMemberPath="Name" SelectionChanged="WorkflowList_SelectionChanged" BorderThickness="1"/>
                <WrapPanel Grid.Row="2" Margin="0 8 0 0">
                    <Button Content="+ 新建" Margin="0 0 4 0" Padding="8 2" Click="NewWorkflow_Click"/>
                    <Button Content="🗑 删除" Padding="8 2" Click="DeleteWorkflow_Click"/>
                </WrapPanel>
            </Grid>
        </Border>

        <Grid Grid.Column="1" Margin="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="工作流步骤" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0 0 0 4" FontSize="12"/>

            <ListView Grid.Row="1" x:Name="StepList" Margin="0 4">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="步骤" Width="40" DisplayMemberBinding="{Binding Index}"/>
                        <GridViewColumn Header="录制文件" Width="180" DisplayMemberBinding="{Binding DisplayName}"/>
                        <GridViewColumn Header="次数" Width="56">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBox Text="{Binding Count, UpdateSourceTrigger=PropertyChanged}" Width="44" HorizontalAlignment="Center" VerticalContentAlignment="Center" TextAlignment="Center" BorderThickness="0" Background="Transparent">
                                        <TextBox.Style>
                                            <Style TargetType="TextBox">
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="TextBox">
                                                            <ScrollViewer x:Name="PART_ContentHost"/>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </TextBox.Style>
                                    </TextBox>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="间隔(ms)" Width="80">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBox Text="{Binding IntervalMs, UpdateSourceTrigger=PropertyChanged}" Width="68" HorizontalAlignment="Center" VerticalContentAlignment="Center" TextAlignment="Center" BorderThickness="0" Background="Transparent">
                                        <TextBox.Style>
                                            <Style TargetType="TextBox">
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="TextBox">
                                                            <ScrollViewer x:Name="PART_ContentHost"/>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </TextBox.Style>
                                    </TextBox>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                    </GridView>
                </ListView.View>
            </ListView>

            <WrapPanel Grid.Row="2" Margin="0 4">
                <Button Content="+ 添加步骤" Margin="0 0 4 0" Padding="8 2" Click="AddStep_Click"/>
                <Button Content="− 移除步骤" Margin="0 0 4 0" Padding="8 2" Click="RemoveStep_Click"/>
                <Button Content="↑ 上移" Margin="0 0 4 0" Padding="8 2" Click="MoveUp_Click"/>
                <Button Content="↓ 下移" Margin="0 0 4 0" Padding="8 2" Click="MoveDown_Click"/>
            </WrapPanel>

            <Border Grid.Row="3" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0 1 0 0" Padding="0 8 0 0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="70"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="60"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Label Content="重复：" VerticalAlignment="Center"/>
                    <ComboBox Grid.Column="1" x:Name="RepeatModeCombo" Margin="4" SelectedIndex="0" VerticalAlignment="Center">
                        <ComboBoxItem Content="单次"/>
                        <ComboBoxItem Content="N 次"/>
                        <ComboBoxItem Content="无限"/>
                    </ComboBox>
                    <Label Grid.Column="2" Content="次数：" VerticalAlignment="Center" x:Name="RepeatCountLabel" Visibility="Collapsed"/>
                    <TextBox Grid.Column="3" x:Name="RepeatCountBox" Margin="4" Text="1" VerticalAlignment="Center" Visibility="Collapsed"/>
                    <Label Grid.Column="4" Content="次" VerticalAlignment="Center" x:Name="RepeatCountSuffix" Visibility="Collapsed"/>
                    <TextBlock Grid.Column="5" x:Name="ExecStatus" VerticalAlignment="Center" Margin="8 0" Foreground="{StaticResource AccentBrush}"/>
                    <WrapPanel Grid.Column="6">
                        <Button x:Name="RunBtn" Content="▶ 执行" Margin="0 0 4 0" Padding="12 4" Width="70" Click="RunBtn_Click" Background="{StaticResource AccentBrush}"/>
                        <Button x:Name="StopExecBtn" Content="■ 停止" Padding="12 4" Width="70" Click="StopExecBtn_Click"/>
                    </WrapPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
