<Window x:Class="KeyMuse.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:pages="clr-namespace:KeyMuse.Wpf.Pages"
        Title="KeyMuse" Height="560" Width="720"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Top: Profile bar -->
        <Border Grid.Row="0" BorderBrush="#ccc" BorderThickness="0 0 0 1" Padding="8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Label Grid.Column="0" Content="配置：" VerticalAlignment="Center"/>
                <ComboBox Grid.Column="1" x:Name="ProfileCombo" Margin="4" SelectionChanged="ProfileCombo_SelectionChanged"/>
                <Button Grid.Column="2" Content="+ 新建" Margin="4" Padding="8 2" Click="NewProfile_Click"/>
            </Grid>
        </Border>

        <!-- Center: Tabs -->
        <TabControl Grid.Row="1" Margin="8">
            <TabItem Header="录制管理">
                <pages:RecordingsPage/>
            </TabItem>
            <TabItem Header="工作流">
                <Grid>
                    <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Text="工作流（待实现）" Foreground="Gray"/>
                </Grid>
            </TabItem>
            <TabItem Header="设置">
                <Grid>
                    <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Text="设置（待实现）" Foreground="Gray"/>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- Bottom: Status bar -->
        <StatusBar Grid.Row="2">
            <StatusBarItem x:Name="StatusItem" Content="就绪"/>
        </StatusBar>
    </Grid>
</Window>
