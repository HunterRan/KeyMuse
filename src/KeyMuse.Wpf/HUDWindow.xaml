<Window x:Class="KeyMuse.Wpf.HUDWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="KeyMuse HUD" Height="180" Width="500"
        WindowStyle="None" AllowsTransparency="True" Background="#CC222222"
        Topmost="True" ShowInTaskbar="False"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual">
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#33000000" CornerRadius="4" Padding="8 6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" x:Name="StatusIcon" Text="●" Foreground="#5BC0EB" FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" x:Name="StatusText" Foreground="#EEE" FontSize="14" VerticalAlignment="Center" Margin="6 0 0 0" Text="空闲" TextTrimming="CharacterEllipsis"/>
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <TextBlock x:Name="ProgressText" Foreground="#AAA" FontSize="11" VerticalAlignment="Center"/>
                    <TextBlock x:Name="CountdownText" Foreground="#5BC0EB" FontSize="11" VerticalAlignment="Center" Margin="6 0 0 0"/>
                </StackPanel>
            </Grid>
        </Border>

        <TextBlock Grid.Row="1" x:Name="EventListText" Margin="0,6,0,6"
                   FontFamily="Consolas" FontSize="11" TextWrapping="NoWrap"
                   VerticalAlignment="Top"/>

        <Border Grid.Row="2" Background="#22000000" CornerRadius="4" Padding="8 6">
            <WrapPanel HorizontalAlignment="Center">
                <TextBlock Margin="0 0 6 0"><Run Text="F6" FontWeight="Bold" Foreground="#5BC0EB"/><Run Text=" 录制" Foreground="#999"/></TextBlock>
                <TextBlock Margin="0 0 6 0"><Run Text="F7" FontWeight="Bold" Foreground="#5BC0EB"/><Run Text=" 回放" Foreground="#999"/></TextBlock>
                <TextBlock Margin="0 0 6 0"><Run Text="F8" FontWeight="Bold" Foreground="#5BC0EB"/><Run Text=" 工作流" Foreground="#999"/></TextBlock>
                <TextBlock Margin="0 0 6 0"><Run Text="F9" FontWeight="Bold" Foreground="#5BC0EB"/><Run Text=" 连点" Foreground="#999"/></TextBlock>
                <TextBlock><Run Text="F10" FontWeight="Bold" Foreground="#5BC0EB"/><Run Text=" 窗口" Foreground="#999"/></TextBlock>
            </WrapPanel>
        </Border>
    </Grid>
</Window>
