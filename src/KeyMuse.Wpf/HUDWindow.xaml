<Window x:Class="KeyMuse.Wpf.HUDWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="KeyMuse HUD" Height="60" Width="240"
        WindowStyle="None" AllowsTransparency="True" Background="#CC222222"
        Topmost="True" ShowInTaskbar="False"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        Icon="KeyMuse.ico">
    <Grid Margin="6">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" x:Name="StatusText" Foreground="#EEE" FontSize="14"
                   FontFamily="Segoe UI" Text="空闲" TextTrimming="CharacterEllipsis"/>
        <TextBlock Grid.Row="1" x:Name="ProgressText" Foreground="#AAA" FontSize="11"
                   FontFamily="Segoe UI" Text=""/>
    </Grid>
</Window>
