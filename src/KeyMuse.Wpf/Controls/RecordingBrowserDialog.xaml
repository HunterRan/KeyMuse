<Window x:Class="KeyMuse.Wpf.Controls.RecordingBrowserDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="选择录制文件" Height="420" Width="560"
        WindowStartupLocation="CenterScreen" ShowInTaskbar="False"
        ResizeMode="NoResize"
        Background="Transparent"
        AllowsTransparency="True"
        WindowStyle="None"
        Foreground="{StaticResource TextBrush}">
    <Border Background="{StaticResource BgBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="16" Effect="{StaticResource ShadowDepth2}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="选择录制文件" FontWeight="SemiBold" FontSize="14" Margin="0 0 0 12"/>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="160"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="6">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="分类" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0 0 0 4"/>
                        <ListBox Grid.Row="1" x:Name="CategoryList" SelectionChanged="CategoryList_SelectionChanged" BorderThickness="0"/>
                    </Grid>
                </Border>

                <Border Grid.Column="2" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="6">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="录制文件" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0 0 0 4"/>
                        <ListView Grid.Row="1" x:Name="RecordingList" SelectionMode="Single" BorderThickness="0">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="名称" Width="180" DisplayMemberBinding="{Binding FileName}"/>
                                    <GridViewColumn Header="事件数" Width="60" DisplayMemberBinding="{Binding EventCount}"/>
                                    <GridViewColumn Header="时长" Width="60" DisplayMemberBinding="{Binding DisplayDuration}"/>
                                </GridView>
                            </ListView.View>
                        </ListView>
                    </Grid>
                </Border>
            </Grid>

            <WrapPanel Grid.Row="2" HorizontalAlignment="Right" Margin="0 12 0 0">
                <Button Content="取消" Margin="0 0 8 0" Padding="16 8" MinWidth="80" IsCancel="True" Click="CancelBtn_Click"/>
                <Button Content="确定" Padding="16 8" MinWidth="80" IsDefault="True" Click="OkBtn_Click" Background="{StaticResource AccentBrush}"/>
            </WrapPanel>
        </Grid>
    </Border>
</Window>
