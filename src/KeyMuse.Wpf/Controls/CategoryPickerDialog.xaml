<Window x:Class="KeyMuse.Wpf.Controls.CategoryPickerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="选择分类" Height="300" Width="360"
        WindowStartupLocation="CenterScreen" ShowInTaskbar="False"
        Topmost="True" ResizeMode="NoResize"
        Background="Transparent"
        AllowsTransparency="True"
        WindowStyle="None"
        Foreground="{StaticResource TextBrush}">
    <Border Background="{StaticResource BgBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="16" Effect="{StaticResource ShadowDepth2}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="选择录制分类" FontWeight="SemiBold" FontSize="14" Margin="0 0 0 12"/>

            <Border Grid.Row="1" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="6">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <ListBox Grid.Row="0" x:Name="CategoryList" SelectionChanged="CategoryList_SelectionChanged" BorderThickness="0"/>
                    <Grid Grid.Row="1" Margin="0 8 0 0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" x:Name="NewCategoryBox"/>
                        <Button Grid.Column="1" Content="新建" Margin="8 0 0 0" Padding="12 4" Click="NewCategoryBtn_Click"/>
                    </Grid>
                </Grid>
            </Border>

            <WrapPanel Grid.Row="2" HorizontalAlignment="Right" Margin="0 12 0 0">
                <Button Content="取消" Margin="0 0 8 0" Padding="16 8" MinWidth="80" IsCancel="True" Click="CancelBtn_Click"/>
                <Button Content="确定" Padding="16 8" MinWidth="80" IsDefault="True" Click="OkBtn_Click" Background="{StaticResource AccentBrush}"/>
            </WrapPanel>
        </Grid>
    </Border>
</Window>
