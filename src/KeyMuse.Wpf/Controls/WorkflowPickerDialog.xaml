<Window x:Class="KeyMuse.Wpf.Controls.WorkflowPickerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="选择工作流"
        WindowStartupLocation="CenterScreen"
        Topmost="True"
        Width="400" Height="300"
        Background="{StaticResource BgBrush}"
        TextElement.Foreground="{StaticResource TextBrush}"
        WindowStyle="None"
        AllowsTransparency="True"
        BorderThickness="1"
        BorderBrush="{StaticResource BorderBrush}">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Text="选择工作流：" Margin="0,0,0,8" FontSize="14"/>
        <ListBox x:Name="WorkflowList" Grid.Row="1" Margin="0,0,0,8"
                 DisplayMemberPath="Name"
                 Background="{StaticResource PanelBrush}"
                 BorderBrush="{StaticResource BorderBrush}"/>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="确定" Width="70" Height="28" Click="OkBtn_Click" Margin="0,0,8,0"
                    Background="{StaticResource AccentBrush}"
                    Foreground="White"/>
            <Button Content="取消" Width="70" Height="28" Click="CancelBtn_Click"
                    Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource BorderBrush}"/>
        </StackPanel>
    </Grid>
</Window>
