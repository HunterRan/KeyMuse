<Window x:Class="KeyMuse.Wpf.Controls.DarkMessageBox"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="KeyMuse" SizeToContent="WidthAndHeight" MinWidth="320" MaxWidth="480"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        ResizeMode="NoResize"
        Background="Transparent"
        AllowsTransparency="True"
        WindowStyle="None"
        Foreground="{StaticResource TextBrush}">
    <Border Background="{StaticResource BgBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="20" Effect="{StaticResource ShadowDepth2}">
        <Grid MinWidth="280">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid Grid.Row="0" Margin="0 0 0 16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border x:Name="IconBorder" Grid.Column="0" Width="36" Height="36" CornerRadius="18" Margin="0 0 12 0" Visibility="Collapsed"/>
                <TextBlock Grid.Column="1" x:Name="TitleText" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
            </Grid>
            <TextBlock Grid.Row="1" x:Name="MessageText" TextWrapping="Wrap" Margin="0 0 0 20" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" LineHeight="20"/>
            <WrapPanel Grid.Row="2" x:Name="ButtonPanel" HorizontalAlignment="Right"/>
        </Grid>
    </Border>
</Window>